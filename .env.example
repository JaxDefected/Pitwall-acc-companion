# ============================================================================
# PITWALL APP - ENVIRONMENT CONFIGURATION TEMPLATE
# ============================================================================

# --- Google Gemini AI API ---
# Required for AI Race Engineer chat and adjustments
GEMINI_API_KEY="your-gemini-api-key"

# --- Client Application URL ---
# Hosted domain URL for self-referential links, OAuth callbacks, and API routing
APP_URL="http://localhost:3000"

# --- Firebase Client SDK (Vite) ---
# Required for client-side authentication and Firestore read/write
VITE_FIREBASE_API_KEY="AIzaSy..."
VITE_FIREBASE_AUTH_DOMAIN="pitwall-companion.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="pitwall-companion"
VITE_FIREBASE_STORAGE_BUCKET="pitwall-companion.appspot.com"
VITE_FIREBASE_MESSAGING_SENDER_ID="1234567890"
VITE_FIREBASE_APP_ID="1:1234567890:web:abcdef"

# --- League Administrator Email ---
# Email address granted administrative access to /admin and claim approvals
VITE_ADMIN_EMAIL="lowther.jack@gmail.com"

# --- Google Sheets & Sync Pipeline (Section 7.5) ---
# Primary Google Sheets workbook ID for Late Night Racing series
SHEET_ID_LNR_ACC="1s9m3yWd-zBLKf4An5rAJ7sxHy9ouU4y8OZjnN9pXoEs"

# Optional: Google Cloud Service Account JSON string for authorized Sheets API access
# Format: Minified single-line JSON string with read-only permissions to the sheet
GOOGLE_SERVICE_ACCOUNT_JSON='{"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}'

# Optional: Firebase Admin Service Account JSON string (if different from Google Cloud service account)
FIREBASE_ADMIN_SERVICE_ACCOUNT_JSON='{"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}'

# --- Vercel Cron & API Security ---
# Secret token required to invoke /api/sync-league via cron or external webhook
CRON_SECRET="your-high-entropy-cron-secret-key"
